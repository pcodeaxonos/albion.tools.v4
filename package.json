{
    "name": "albion.tools.v4",
    "version": "4.0.0",
    "private": true,
    "description": "Albion Online tools — static HTML, no backend",
    "scripts": {
        "css:build": "node node_modules/sass/sass.js scss/main.scss css/site.css --no-source-map",
        "css:watch": "node node_modules/sass/sass.js --watch scss/main.scss css/site.css --no-source-map",
        "data:fetch": "node scripts/fetch-game-data.mjs",
        "data:icons": "node scripts/fetch-item-icons.mjs",
    "data:farm": "node scripts/build-farm-catalog.mjs",
    "data:craft": "node scripts/build-craft-catalog.mjs && node scripts/build-game-recipe-catalog.mjs",
    "data:game-recipes": "node scripts/build-game-recipe-catalog.mjs",
    "data:app": "node scripts/build-app-catalog.mjs && node scripts/build-legacy-routes.mjs",
    "routes:build": "node scripts/build-legacy-routes.mjs",
    "data:build": "npm run data:craft && node scripts/build-farm-catalog.mjs && node scripts/build-app-catalog.mjs",
        "prices": "node scripts/price-hub.mjs",
        "trades": "node scripts/trade-hub.mjs",
        "sat:trades:test": "node scripts/sat-trades/self-test.mjs",
        "serve": "npx --yes serve . -p 3000 --no-port-switching"
    },
    "devDependencies": {
        "sass": "1.77.8"
    }
}
