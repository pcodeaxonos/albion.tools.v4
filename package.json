{
    "name": "albion.tools.v4",
    "version": "4.0.0",
    "private": true,
    "description": "Albion Online tools — static HTML, no backend",
    "scripts": {
        "city:test": "node --experimental-vm-modules content/scripts/test-city-picker.mjs",
        "laborer:test": "node --experimental-vm-modules content/scripts/test-laborer-contract.mjs",
        "css:build": "node node_modules/sass/sass.js content/scss/main.scss output/css/site.css --no-source-map",
        "css:watch": "node node_modules/sass/sass.js --watch content/scss/main.scss output/css/site.css --no-source-map",
        "data:fetch": "node content/scripts/fetch-game-data.mjs",
        "island:test": "node --experimental-vm-modules content/scripts/test-island-economy.mjs",
        "island:stability:test": "node content/scripts/test-island-yield-stability.mjs",
        "island:forecast:test": "node content/scripts/test-island-yield-forecast.mjs",
        "data:icons": "node content/scripts/fetch-item-icons.mjs",
    "data:farm": "node content/scripts/build-farm-catalog.mjs",
    "data:craft": "node content/scripts/build-craft-catalog.mjs && node content/scripts/build-game-recipe-catalog.mjs",
    "data:game-recipes": "node content/scripts/build-game-recipe-catalog.mjs",
    "data:app": "node content/scripts/build-app-catalog.mjs && node content/scripts/build-site-routes.mjs",
    "routes:build": "node content/scripts/build-site-routes.mjs",
    "routes:test": "node content/scripts/test-routes.mjs",
    "data:build": "npm run data:craft && node content/scripts/build-farm-catalog.mjs && node content/scripts/build-app-catalog.mjs",
        "prices": "node content/scripts/price-hub.mjs",
        "prices:history:test": "node content/scripts/test-market-order-history.mjs",
        "prices:collector:test": "node content/scripts/test-aodp-collector.mjs",
        "prices:collector:live": "node content/scripts/test-aodp-live.mjs",
        "trades": "node content/scripts/trade-hub.mjs",
        "sat:trades:test": "node content/scripts/sat-trades/self-test.mjs",
        "serve": "node content/scripts/serve.mjs"
    },
    "devDependencies": {
        "sass": "1.77.8"
    }
}
